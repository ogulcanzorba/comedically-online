# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
MODERATION_MODE=mock
MAX_SPEND_USD=5
# Per-model timeouts in ms (defaults shown).
# VOICE_TIMEOUT_MS=8000
# SAM_TIMEOUT_MS=20000
# SAM_IMAGE_TIMEOUT_MS=6000
# SPARK_TIMEOUT_MS=8000
# Chunks moderating at once (default 8; quota allows more).
# MOD_POOL=8
# Failed visual check in live mode: closed (blur in full) or open (release
# unblurred with a warning, for demo testing). Audio always fails closed.
# VISUAL_FAIL_MODE=closed
# Max hold past the playback delay before an unmoderated chunk is released
# censored instead of blocking the queue (ms).
# MAX_HOLD_MS=4000
PORT=3000
# PLAYBACK_DELAY_MS=12000
# Required in production; dev falls back to an insecure default with a warning.
SESSION_SECRET=
TAG_MODE=mock
# Public site URL for canonical links, sitemap, and OG tags.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional SQLite file location (default: data/comedically.db).
# SQLITE_FILE=./data/comedically.db
# Visual sampling debug: 2 samples t~=0.5s/1.5s per chunk (2x image cost).
# SAM_FRAMES_PER_CHUNK=1
# Save sampled JPEGs to ./debug-frames plus per-concept [sam] logs.
# DEBUG_FRAMES=1
# Save moderation inputs to /tmp/chunks (+ manifest) for npm run soak:live.
# DEBUG_CAPTURE=1
# CHUNKS_DIR=/tmp/chunks
