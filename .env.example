# Copy to .env and fill in. Never commit .env.
MODEL_API_KEY=
MODERATION_MODE=mock
MAX_SPEND_USD=5
# Per-model timeouts in ms (defaults shown).
# VOICE_TIMEOUT_MS=8000
# SAM_TIMEOUT_MS=20000
# SAM_IMAGE_TIMEOUT_MS=6000
# SPARK_TIMEOUT_MS=8000
# GATE_TIMEOUT_MS=8000
# Live vision backend: spark (one multi-frame Responses call, default),
# sam (legacy per-concept segmentation), or gate (one VLM call per frame).
# VISUAL_STRATEGY is a legacy alias (sam only) when this is unset.
# VISION_BACKEND=spark
# Spark vision model + first-pass effort (unsure band retries at low).
# SPARK_VISION_MODEL=muse-spark-1.3
# SPARK_VISION_EFFORT=minimal
# Vision confidence thresholds: >= HIT blurs; [UNSURE, HIT) gets a 2nd call.
# VISION_HIT=0.5
# VISION_UNSURE=0.3
# Spark vision timeout per call in ms (default 8000; fits the 12s delay).
# VISION_TIMEOUT_MS=8000
# Consecutive clean frames that release a tracked gesture blur (~1s at 2; default 2).
# RELEASE_CLEAN_FRAMES=2
# Viewer/recap/download blur strength in px (default 28; download also pixelates).
# NEXT_PUBLIC_BLUR_PX=28
# Realtime emission lag in ms (ASR frontier past the true word end).
# REALTIME_LAG_MS=250
# Spark billing tier: standard ($1.25/$4.25 per 1M) or contributor ($0.10/$0.20).
# SPARK_PRICING_MODE=standard
# Gate VLM calls per chunk over the middle sampled frames (1-4, default 2).
# GATE_FRAMES=2
# Chunks moderating at once (default 8; quota allows more).
# MOD_POOL=8
# Failed visual check in live mode: closed (blur in full) or open (release
# unblurred with a warning, for demo testing). Audio always fails closed.
# VISUAL_FAIL_MODE=closed
# Max hold past the playback delay before an unmoderated chunk is released
# censored instead of blocking the queue (ms).
# MAX_HOLD_MS=4000
PORT=3000
# PLAYBACK_DELAY_MS=12000
# Required in production; dev falls back to an insecure default with a warning.
SESSION_SECRET=
TAG_MODE=mock
# Public site URL for canonical links, sitemap, and OG tags.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional SQLite file location (default: data/comedically.db).
# SQLITE_FILE=./data/comedically.db
# Frames sampled per 2s chunk (server fallback + cap; default 4).
# FRAMES_PER_CHUNK=4
# Same number for the studio canvas capture (must match; restart dev to apply).
# NEXT_PUBLIC_FRAMES_PER_CHUNK=4
# Sampled-frame width in px (server extract; default 640).
# FRAME_WIDTH=640
# Same width for the studio canvas capture (must match; restart dev to apply).
# NEXT_PUBLIC_FRAME_WIDTH=640
# Neighbor chunks blurred around a flagged chunk (default 0; raise for SAM).
# BLUR_PAD_CHUNKS=0
# Pre-show viewer countdown in ms once the comedian starts (default 10s).
# START_COUNTDOWN_MS=10000
# Save sampled JPEGs to ./debug-frames plus per-concept [sam] logs.
# DEBUG_FRAMES=1
# Save moderation inputs to /tmp/chunks (+ manifest) for npm run soak:live.
# DEBUG_CAPTURE=1
# CHUNKS_DIR=/tmp/chunks
